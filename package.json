{
  "name": "kapusz",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev:tenis": "npm run dev -w @kapusz/kapusz-tenis",
    "dev:academy": "npm run dev -w @kapusz/academy",
    "build": "npm run build --workspaces --if-present",
    "build:tenis": "npm run build -w @kapusz/kapusz-tenis",
    "build:academy": "npm run build -w @kapusz/academy",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
