---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/blog/PostCard.astro";
import { getPosts } from "../../lib/posts";

const posts = await getPosts();
---

<Base
  title="Blog - Lekcje Tenisa z Michałem Kapuszem | Wrocław"
  description="Blog o tenisie - porady, wskazówki i ciekawostki dla graczy na każdym poziomie zaawansowania. Dowiedz się więcej o technice, taktyce i sprzęcie tenisowym."
  crumbs={[{ name: "Blog", path: "/blog/" }]}
>
  <section class="k-dark">
    <div class="k-container bl-hero">
      <p class="k-eyebrow k-eyebrow--accent">Blog</p>
      <h1 class="k-h1 bl-h1">Blog tenisowy.</h1>
      <p class="k-lead">Porady, wskazówki i ciekawostki dla graczy na każdym poziomie zaawansowania.</p>
    </div>
  </section>
  <section class="k-snow">
    <div class="k-container bl-body">
      {
        posts.length > 0 ? (
          <div class="bl-grid rv kids">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <p class="bl-empty">Wkrótce pojawią się nowe artykuły!</p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .bl-hero {
    padding-block: 150px 90px;
  }

  .bl-h1 {
    margin-top: 16px;
  }

  .bl-body {
    padding-block: 96px 140px;
  }

  .bl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  .bl-empty {
    text-align: center;
    color: var(--k-gray-600);
  }
</style>
