---
/** Nawigacja i stopka kapusz-tenis.pl owinięte wokół treści strony. */
import SiteNav from "@kapusz/ui/SiteNav.astro";
import SiteFooter from "@kapusz/ui/SiteFooter.astro";
import logoMark from "@kapusz/brand/assets/logo-mark.webp";
import { addressLine, contact, sites, social } from "@kapusz/brand/contact";
---

<SiteNav
  brand="Michał Kapusz"
  homeHref="/"
  currentPath={Astro.url.pathname}
  links={[
    { href: "/", label: "Strona główna" },
    { href: "/cennik/", label: "Cennik" },
    { href: "/blog/", label: "Blog" },
    { href: sites.academy, label: "Akademia" },
  ]}
  cta={{ href: "/#kontakt", label: "Umów trening" }}
/>

<main>
  <slot />
</main>

<SiteFooter
  legal="© 2026 Michał Kapusz. Wszystkie prawa zastrzeżone."
  columns={[
    {
      title: "Nawigacja",
      links: [
        { href: "/", label: "Strona główna" },
        { href: "/cennik/", label: "Cennik" },
        { href: "/blog/", label: "Blog" },
        { href: sites.academy, label: "Kapusz Tennis Academy" },
      ],
    },
    {
      title: "Kontakt",
      links: [
        { href: `tel:${contact.phone}`, label: contact.phoneDisplay },
        { href: `mailto:${contact.email}`, label: contact.email },
        { label: addressLine },
      ],
    },
    {
      title: "Social media",
      links: [
        { href: social.instagram, label: "Instagram", external: true },
        { href: social.facebook, label: "Facebook", external: true },
      ],
    },
  ]}
>
  <a slot="logo" href="/" class="ft-brand">
    <img src={logoMark.src} width={logoMark.width} height={logoMark.height} alt="" />
    <span>Michał Kapusz<small>Trener tenisa · Wrocław</small></span>
  </a>
  <span slot="bottom">
    powered by <a href="https://aniszewski.dev" target="_blank" rel="noopener noreferrer">Jakub Aniszewski IT Solutions</a>
  </span>
</SiteFooter>

<style>
  .ft-brand {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--k-snow);
    text-decoration: none;
  }

  .ft-brand img {
    height: 44px;
    width: auto;
  }

  .ft-brand span {
    display: flex;
    flex-direction: column;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .ft-brand small {
    font-family: var(--k-font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--k-gray-500);
  }
</style>
