---
import { Image } from "astro:assets";
import logoMark from "@kapusz/brand/assets/logo-mark.webp";
import stadium from "../assets/hero/stadium.jpg";
import coaches from "../assets/hero/coaches.webp";
import { coaches as team } from "../data/team";

// Błyski fleszy na trybunach: pozycja (%), czas trwania i opóźnienie (s).
const flashes: [number, number, number, number][] = [
  [16.0, 26.1, 9.5, 10.1],
  [5.2, 42.7, 6.9, 10.5],
  [28.7, 28.6, 9.6, 10.3],
  [39.1, 46.4, 12.9, 4.0],
  [91.4, 47.0, 8.7, 5.2],
  [89.1, 27.3, 8.5, 6.5],
  [3.6, 48.2, 5.5, 8.9],
  [8.3, 29.1, 12.8, 6.6],
  [18.5, 35.2, 10.6, 3.0],
  [18.7, 27.2, 9.9, 7.5],
  [7.0, 28.8, 11.1, 10.6],
  [86.5, 45.5, 9.7, 7.2],
  [13.3, 34.4, 7.2, 3.9],
  [38.6, 33.6, 9.0, 4.1],
  [11.3, 32.6, 9.6, 2.7],
  [85.1, 42.3, 7.5, 8.7],
  [76.2, 37.7, 13.1, 7.1],
  [77.8, 26.7, 13.0, 9.3],
];

// Reflektory: pozycja środka (%), szerokość (%) i opóźnienia animacji (włączenie, migotanie).
const floods: [number, number, number, string][] = [
  [4.7, 13.8, 24, ".1s, 2.4s"],
  [23.4, 24.1, 15, ".12s, 5.1s"],
  [76.6, 24.1, 15, ".2s, 3.7s"],
  [93.8, 15.6, 24, ".28s, 6.3s"],
];

const [left, head, right] = team;
const imgSizes = "max(100vw, 1440px)";
---

<section id="top" class="scene" data-scene>
  <div class="stage">
    <div class="push">
      <div class="settle">
        <div class="plate" aria-hidden="true">
          <Image src={stadium} alt="" widths={[1440, 2560]} sizes={imgSizes} loading="eager" fetchpriority="high" class="plate-on fill" />
        </div>
        {
          floods.map(([x, y, w, delay]) => (
            <div class="flood" aria-hidden="true" style={`left:${x}%;top:${y}%;width:${w}%;animation-delay:${delay}`} />
          ))
        }
        <div class="flashes" aria-hidden="true">
          {
            flashes.map(([x, y, dur, delay]) => (
              <span class="flash" style={`left:${x}%;top:${y}%;animation-duration:${dur}s;animation-delay:${delay}s`} />
            ))
          }
        </div>
        <Image
          src={coaches}
          alt="Trenerzy Kapusz Tennis Academy — w środku head coach Michał Kapusz"
          widths={[1440, 2560]}
          sizes={imgSizes}
          loading="eager"
          class="expose fill coaches"
        />
        <Image src={coaches} alt="" aria-hidden="true" widths={[1440, 2560]} sizes={imgSizes} loading="eager" class="on-l fill" />
        <Image src={coaches} alt="" aria-hidden="true" widths={[1440, 2560]} sizes={imgSizes} loading="eager" class="on-c fill" />
        <Image src={coaches} alt="" aria-hidden="true" widths={[1440, 2560]} sizes={imgSizes} loading="eager" class="on-r fill" />
        <div class="expose glow" aria-hidden="true"></div>
        <div class="spot spot-l" aria-hidden="true"></div>
        <div class="spot spot-c" aria-hidden="true"></div>
        <div class="spot spot-r" aria-hidden="true"></div>
      </div>
    </div>

    <div class="vignette" aria-hidden="true"></div>
    <div class="sheen-wrap" aria-hidden="true"><div class="sheen"></div></div>
    <div class="k-grain-wrap" aria-hidden="true"><div class="k-grain k-grain--lg"></div></div>

    <div class="hero-copy">
      <div class="rise brand" style="animation-delay: 1.5s">
        <img src={logoMark.src} width={logoMark.width} height={logoMark.height} alt="" />
        <span>Kapusz Tennis Academy</span>
      </div>
      <h1 class="k-h1 hero-h1">
        <span class="mask"><span style="animation-delay: 1.6s">Zbuduj swoją grę.</span></span>
      </h1>
      <p class="rise hero-lead" style="animation-delay: 1.9s">
        Zespół licencjonowanych trenerów i jedna metodyka. Head coach Michał Kapusz osobiście pilnuje postępów
        każdego zawodnika.
      </p>
      <div class="rise k-actions hero-actions" style="animation-delay: 2.05s">
        <a class="k-pill" href="#cennik">Umów trening próbny</a>
        <a class="k-link" href="#zespol">Poznaj zespół <span class="k-chev">›</span></a>
      </div>
    </div>

    <div class="cap cap-l" aria-hidden="true">
      <p class="k-eyebrow k-eyebrow--accent">01 — Trener</p>
      <p class="cap-name">{left.name}</p>
      <p class="cap-sub">{left.focus}</p>
    </div>
    <div class="cap cap-c" aria-hidden="true">
      <p class="k-eyebrow k-eyebrow--accent">02 — Head coach</p>
      <p class="cap-name cap-name--lg">{head.name}</p>
      <p class="cap-sub">Założyciel akademii i autor jej metodyki. Licencja PZT i ITF.</p>
    </div>
    <div class="cap cap-r" aria-hidden="true">
      <p class="k-eyebrow k-eyebrow--accent">03 — Trener</p>
      <p class="cap-name">{right.name}</p>
      <p class="cap-sub">{right.focus}</p>
    </div>
    <div class="finale" aria-hidden="true">
      <p class="finale-h">Jeden zespół.<br /><span class="k-muted">Jedna metoda.</span></p>
      <div class="k-actions finale-actions">
        <a class="k-pill" href="#cennik" tabindex="-1">Umów trening próbny</a>
        <a class="k-link" href="#zespol" tabindex="-1">Poznaj zespół <span class="k-chev">›</span></a>
      </div>
    </div>
    <div class="cue-wrap" aria-hidden="true"><div class="cue"></div></div>
  </div>
</section>

<style>
  /* ---------- Układ sceny ---------- */
  .scene {
    position: relative;
    margin-top: calc(var(--k-nav-h) * -1);
    height: 900px;
    background: var(--k-black);
  }

  .stage {
    position: relative;
    top: 0;
    height: 900px;
    overflow: hidden;
    background: var(--k-black);
  }

  .push {
    position: absolute;
    left: 50%;
    top: 44%;
    width: max(100%, 1440px);
    aspect-ratio: 16 / 10;
    translate: -50% -50%;
  }

  .settle,
  .plate,
  .flashes {
    position: absolute;
    inset: 0;
  }

  .plate {
    opacity: 0.85;
  }

  .fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .coaches {
    filter: drop-shadow(0 0 22px rgba(170, 190, 255, 0.14));
  }

  .on-l,
  .on-c,
  .on-r {
    -webkit-mask-image: var(--m);
    mask-image: var(--m);
  }

  .on-l {
    --m: radial-gradient(ellipse 12% 30% at 33.8% 34%, #000 30%, transparent 100%);
  }

  .on-c {
    --m: radial-gradient(ellipse 12% 30% at 50% 33%, #000 30%, transparent 100%);
  }

  .on-r {
    --m: radial-gradient(ellipse 12% 30% at 65.2% 35%, #000 30%, transparent 100%);
  }

  .glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(40% 34% at 50% 6%, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0) 72%);
    mix-blend-mode: screen;
  }

  .flood {
    position: absolute;
    aspect-ratio: 1.6 / 1;
    translate: -50% -50%;
    background: radial-gradient(
      closest-side,
      rgba(214, 226, 255, 0.26),
      rgba(214, 226, 255, 0.06) 45%,
      rgba(214, 226, 255, 0)
    );
    mix-blend-mode: screen;
    animation:
      hero-flood 1.5s linear both,
      hero-shimmer 7s ease-in-out infinite;
  }

  .flash {
    position: absolute;
    width: 3px;
    height: 3px;
    margin: -1.5px 0 0 -1.5px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 6px 2px rgba(255, 255, 255, 0.7),
      0 0 20px 6px rgba(205, 220, 255, 0.22);
    opacity: 0;
    animation-name: hero-flash;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .spot {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .spot-l {
    background: radial-gradient(ellipse 15% 44% at 33.8% 46%, rgba(0, 0, 0, 0) 48%, rgba(0, 0, 0, 0.86) 100%);
  }

  .spot-c {
    background: radial-gradient(ellipse 17% 46% at 50% 46%, rgba(0, 0, 0, 0) 48%, rgba(0, 0, 0, 0.86) 100%);
  }

  .spot-r {
    background: radial-gradient(ellipse 15% 44% at 65.2% 46%, rgba(0, 0, 0, 0) 48%, rgba(0, 0, 0, 0.86) 100%);
  }

  .vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(130% 100% at 50% 34%, rgba(0, 0, 0, 0) 56%, rgba(0, 0, 0, 0.62) 100%),
      radial-gradient(70% 60% at 50% 100%, rgba(0, 0, 0, 0.97) 45%, rgba(0, 0, 0, 0) 100%),
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.55) 0%,
        rgba(0, 0, 0, 0) 13%,
        rgba(0, 0, 0, 0) 40%,
        rgba(0, 0, 0, 0.6) 62%,
        rgba(0, 0, 0, 0.92) 86%,
        #000 100%
      );
  }

  .sheen-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .sheen {
    position: absolute;
    top: -10%;
    bottom: -10%;
    left: 0;
    width: 40%;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.08) 50%, rgba(255, 255, 255, 0));
    mix-blend-mode: screen;
    animation: hero-sheen 2s ease-in-out 1.9s both;
  }

  /* ---------- Tekst ---------- */
  .hero-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 64px;
    padding: 0 var(--k-gutter);
    text-align: center;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand img {
    height: 26px;
    width: auto;
  }

  .hero-h1 {
    margin-top: 16px;
  }

  .mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }

  .mask > span {
    display: block;
    animation: hero-line-up 1.1s var(--k-ease-out) both;
  }

  .hero-lead {
    margin: 22px auto 0;
    max-width: 660px;
    font-size: var(--k-text-lead);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--k-gray-400);
  }

  .hero-actions,
  .finale-actions {
    margin-top: 30px;
    justify-content: center;
  }

  .cap,
  .finale {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .cap p {
    margin: 0;
  }

  .cap-l {
    left: max(32px, calc(50% - 680px));
    top: 38%;
    width: 360px;
  }

  .cap-r {
    right: max(32px, calc(50% - 680px));
    top: 38%;
    width: 360px;
    text-align: right;
  }

  .cap-c {
    left: 0;
    right: 0;
    bottom: 80px;
    padding: 0 var(--k-gutter);
    text-align: center;
  }

  .cap .cap-name {
    margin-top: 12px;
    font-size: 40px;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .cap .cap-name--lg {
    font-size: 56px;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .cap .cap-sub {
    margin-top: 12px;
    font-size: 17px;
    line-height: 1.45;
    color: var(--k-gray-400);
  }

  .cap-c .cap-sub {
    max-width: 460px;
    margin-inline: auto;
  }

  .finale {
    left: 0;
    right: 0;
    bottom: 72px;
    padding: 0 var(--k-gutter);
    text-align: center;
  }

  .finale-h {
    margin: 0;
    font-size: clamp(44px, 6vw, 88px);
    font-weight: 600;
    line-height: 1.03;
    letter-spacing: var(--k-tracking-tight);
  }

  .cue-wrap {
    position: absolute;
    left: 50%;
    bottom: 18px;
    translate: -50% 0;
    display: none;
    width: 1px;
    height: 40px;
    background: rgba(255, 255, 255, 0.14);
    overflow: hidden;
  }

  .cue {
    width: 1px;
    height: 40px;
    background: var(--k-snow);
    animation: hero-cue 2.2s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }

  /* ---------- Animacje wejścia ---------- */
  .plate-on {
    animation: hero-plate 1.5s linear 0.1s both;
  }

  .settle {
    animation: hero-settle 4.4s var(--k-ease-out) both;
  }

  .expose {
    animation: hero-expose 1.4s ease-in-out 1.3s both;
  }

  .on-l {
    animation: hero-light 0.9s ease-out 0.6s both;
  }

  .on-c {
    animation: hero-light 0.9s ease-out 0.85s both;
  }

  .on-r {
    animation: hero-light 0.9s ease-out 1.1s both;
  }

  .rise {
    animation: hero-rise 1s var(--k-ease-out) both;
  }

  /* ---------- Tryb przewijany (desktop, przeglądarki ze scroll-driven animations) ---------- */
  .scene.motion {
    height: 4200px;
    view-timeline-name: --scene;
  }

  .motion .stage {
    position: sticky;
    height: 100vh;
  }

  .motion .push {
    width: max(100%, 160vh);
  }

  .motion .cue-wrap {
    display: block;
  }

  .motion .hero-copy,
  .motion .spot,
  .motion .cap,
  .motion .finale,
  .motion .push,
  .motion .cue-wrap {
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-timeline: --scene;
    animation-range: contain 0% contain 100%;
  }

  .motion .hero-copy {
    animation-name: hero-out;
  }
  .motion .spot-l {
    animation-name: hero-spot-l;
  }
  .motion .spot-c {
    animation-name: hero-spot-c;
  }
  .motion .spot-r {
    animation-name: hero-spot-r;
  }
  .motion .cap-l {
    animation-name: hero-cap-l;
  }
  .motion .cap-c {
    animation-name: hero-cap-c;
  }
  .motion .cap-r {
    animation-name: hero-cap-r;
  }
  .motion .finale {
    animation-name: hero-finale;
    pointer-events: auto;
  }
  .motion .push {
    animation-name: hero-push;
  }
  .motion .cue-wrap {
    animation-name: hero-cue-out;
  }

  @media (max-width: 600px) {
    .hero-copy {
      bottom: 48px;
    }
  }

  /* ---------- Klatki kluczowe ---------- */
  @keyframes hero-light {
    0% {
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
    52% {
      opacity: 0.6;
    }
    66%,
    100% {
      opacity: 1;
    }
  }
  @keyframes hero-expose {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes hero-settle {
    from {
      transform: scale(1.07);
    }
    to {
      transform: scale(1);
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-line-up {
    from {
      transform: translateY(108%);
    }
    to {
      transform: none;
    }
  }
  @keyframes hero-sheen {
    0% {
      transform: translateX(-60%) skewX(-16deg);
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    100% {
      transform: translateX(260%) skewX(-16deg);
      opacity: 0;
    }
  }
  @keyframes hero-plate {
    0% {
      opacity: 0;
    }
    7% {
      opacity: 0.55;
    }
    11% {
      opacity: 0.05;
    }
    19% {
      opacity: 0.7;
    }
    24% {
      opacity: 0.18;
    }
    33% {
      opacity: 0.9;
    }
    39% {
      opacity: 0.5;
    }
    52%,
    100% {
      opacity: 1;
    }
  }
  @keyframes hero-flood {
    0% {
      opacity: 0;
    }
    7% {
      opacity: 1;
    }
    11% {
      opacity: 0;
    }
    19% {
      opacity: 1;
    }
    24% {
      opacity: 0.12;
    }
    33% {
      opacity: 1;
    }
    39% {
      opacity: 0.55;
    }
    52%,
    100% {
      opacity: 1;
    }
  }
  @keyframes hero-shimmer {
    0%,
    44%,
    100% {
      opacity: 1;
    }
    46% {
      opacity: 0.7;
    }
    48% {
      opacity: 1;
    }
    50% {
      opacity: 0.82;
    }
    52% {
      opacity: 1;
    }
  }
  @keyframes hero-flash {
    0%,
    92% {
      opacity: 0;
      transform: scale(0.5);
    }
    93.5% {
      opacity: 1;
      transform: scale(1);
    }
    95.5% {
      opacity: 0.3;
    }
    97%,
    100% {
      opacity: 0;
    }
  }
  @keyframes hero-cue {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    45% {
      transform: scaleY(1);
      transform-origin: top;
    }
    55% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
  @keyframes hero-out {
    0%,
    5% {
      opacity: 1;
      transform: none;
    }
    13%,
    100% {
      opacity: 0;
      transform: translateY(-48px);
    }
  }
  @keyframes hero-spot-l {
    0%,
    14% {
      opacity: 0;
    }
    20%,
    35% {
      opacity: 1;
    }
    41%,
    100% {
      opacity: 0;
    }
  }
  @keyframes hero-spot-c {
    0%,
    38% {
      opacity: 0;
    }
    44%,
    59% {
      opacity: 1;
    }
    65%,
    100% {
      opacity: 0;
    }
  }
  @keyframes hero-spot-r {
    0%,
    62% {
      opacity: 0;
    }
    68%,
    83% {
      opacity: 1;
    }
    89%,
    100% {
      opacity: 0;
    }
  }
  @keyframes hero-cap-l {
    0%,
    17% {
      opacity: 0;
      transform: translateY(32px);
    }
    23%,
    33% {
      opacity: 1;
      transform: none;
    }
    39%,
    100% {
      opacity: 0;
      transform: translateY(-32px);
    }
  }
  @keyframes hero-cap-c {
    0%,
    41% {
      opacity: 0;
      transform: translateY(32px);
    }
    47%,
    57% {
      opacity: 1;
      transform: none;
    }
    63%,
    100% {
      opacity: 0;
      transform: translateY(-32px);
    }
  }
  @keyframes hero-cap-r {
    0%,
    65% {
      opacity: 0;
      transform: translateY(32px);
    }
    71%,
    81% {
      opacity: 1;
      transform: none;
    }
    87%,
    100% {
      opacity: 0;
      transform: translateY(-32px);
    }
  }
  @keyframes hero-finale {
    0%,
    88% {
      opacity: 0;
      transform: translateY(32px);
    }
    95%,
    100% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-push {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.07);
    }
  }
  @keyframes hero-cue-out {
    0%,
    3% {
      opacity: 1;
    }
    8%,
    100% {
      opacity: 0;
    }
  }
</style>

<script>
  // Scena przewijana tylko tam, gdzie ma sens: szeroki ekran, nie za wysoki, wsparcie scroll-driven animations
  // i brak preferencji ograniczenia ruchu. W pozostałych przypadkach hero jest statyczne.
  const scene = document.querySelector<HTMLElement>("[data-scene]");
  if (scene) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const update = () => {
      let ok = false;
      try {
        ok =
          !reduce.matches &&
          window.innerHeight < 1400 &&
          window.innerWidth > 900 &&
          CSS.supports("animation-timeline: view()");
      } catch {
        ok = false;
      }
      scene.classList.toggle("motion", ok);
    };
    update();
    window.addEventListener("resize", update);
  }
</script>
