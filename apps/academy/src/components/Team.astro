---
import { Image } from "astro:assets";
import { coaches } from "../data/team";
---

<section id="zespol" class="k-light">
  <div class="k-container k-section">
    <div class="team-head rv">
      <h2 class="k-h2 team-h2"><span class="ln"><span>Poznaj zespół.</span></span></h2>
      <p class="k-lead fade team-lead">
        Każdy trener akademii pracuje według tej samej metodyki — niezależnie od kortu i godziny.
      </p>
    </div>
    <div class="team-grid rv kids">
      {
        coaches.map((coach, i) => (
          <article>
            <div class="zoom clip team-photo">
              <Image src={coach.photo} alt={coach.photoAlt} widths={[400, 540]} sizes="(min-width: 1000px) 360px, 90vw" />
              {coach.headCoach && <span class="team-badge">Head coach</span>}
            </div>
            <div class="team-body">
              <p class="k-eyebrow">
                {String(i + 1).padStart(2, "0")} · {coach.role}
              </p>
              <h3 class="team-name">{coach.name}</h3>
              <dl class="team-dl">
                {coach.details.map(([label, value]) => (
                  <div>
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .team-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .team-h2,
  .team-lead {
    margin: 0;
  }

  .team-lead {
    max-width: 400px;
  }

  .team-grid {
    margin-top: 64px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 28px;
  }

  .team-photo {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: var(--k-radius-md);
    overflow: hidden;
    background: var(--k-black);
  }

  .team-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team-badge {
    position: absolute;
    left: 18px;
    top: 18px;
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 12px;
    border-radius: var(--k-radius-pill);
    background: var(--k-accent);
    color: var(--k-accent-ink);
    font-size: 12px;
    font-weight: 600;
  }

  .team-body {
    padding: 24px 2px 0;
  }

  .team-name {
    margin: 8px 0 0;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .team-dl {
    margin: 20px 0 0;
    border-top: 1px solid var(--k-gray-300);
    font-size: 15px;
  }

  .team-dl div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 13px 0;
    border-bottom: 1px solid var(--k-gray-200);
  }

  .team-dl dt {
    color: var(--k-gray-600);
  }

  .team-dl dd {
    margin: 0;
    font-weight: 500;
    text-align: right;
  }
</style>
